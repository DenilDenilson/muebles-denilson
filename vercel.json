{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "headers": [{
    "source": "/models/:path*",
    "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]
  }]
}
